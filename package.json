{
  "name": "cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm pdf && astro dev",
    "build": "pnpm validate && pnpm pdf && astro build",
    "preview": "astro preview",
    "pdf": "node scripts/build-pdf.ts",
    "pdf:watch": "typst watch --root . --font-path typst/fonts --ignore-system-fonts --input lang=es typst/cv.typ public/cv-es.pdf",
    "validate": "node scripts/validate.ts",
    "check": "pnpm validate && astro check && biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "rehype-mermaid": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
