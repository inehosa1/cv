---
import { Image } from 'astro:assets';
import { formatDate } from '../lib/format.ts';
import { routes, ui } from '../lib/i18n.ts';
import { type Project, projectSlug } from '../lib/projects.ts';
import type { CV, Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';
import DiagramThumb from './DiagramThumb.astro';
import Icon from './Icon.astro';

interface Props {
  entry: Project;
  lang: Lang;
  labels: CV['meta']['labels'];
  /** Tarjeta grande con captura de la web (`cover`) o miniatura del diagrama de arquitectura. */
  featured?: boolean;
  /** Sin etiquetas (la home ya enlaza a la landing completa). */
  compact?: boolean;
}

const { entry, lang, labels: L, featured = false, compact = false } = Astro.props;
const t = ui[lang];
const d = entry.data;
const href = withBase(routes.project(projectSlug(entry))[lang]);
/** Las tarjetas muestran como mucho dos cifras: las primeras del caso, que son resultados. */
const metrics = d.metrics.slice(0, 2);
---

<article
  class:list={[
    'reveal group relative flex h-full overflow-hidden rounded-xl border border-rule bg-surface transition-colors hover:border-accent/60',
    featured ? 'flex-col lg:flex-row' : 'flex-col',
  ]}
>
  {
    featured &&
      (d.cover ? (
        <div class="flex shrink-0 items-center border-b border-rule bg-bg p-4 sm:p-6 lg:w-[45%] lg:border-r lg:border-b-0">
          <Image
            src={d.cover}
            alt={`${t.coverAlt} ${d.links[0]?.label ?? d.client}`}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 480px, 100vw"
            class="block h-auto w-full rounded-md border border-rule"
          />
        </div>
      ) : (
        <div class="relative hidden h-64 shrink-0 border-b border-rule bg-bg p-4 sm:block lg:h-auto lg:w-[45%] lg:border-r lg:border-b-0">
          <DiagramThumb body={entry.body} id={entry.id} class="h-full" />
        </div>
      ))
  }

  <div class:list={['flex flex-1 flex-col', featured ? 'p-6 sm:p-8 lg:p-10' : 'p-6']}>
    <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
      {d.status === 'development' && <span class="status-badge">{t.inDevelopment}</span>}
      <p>
        {d.client} · <time datetime={d.start}>{formatDate(d.start, L)}</time> –{' '}
        {d.end ? <time datetime={d.end}>{formatDate(d.end, L)}</time> : L.present}
      </p>
    </div>

    <h3 class:list={['mt-2 font-semibold tracking-tight text-balance', featured ? 'text-2xl' : 'text-xl']}>
      <a href={href} class="after:absolute after:inset-0 group-hover:text-accent-ink">{d.title}</a>
    </h3>
    <p class="mt-2 leading-relaxed text-pretty text-muted">{d.tagline}</p>

    {
      metrics.length > 0 && (
        <dl class="mt-5 grid grid-cols-2 gap-4">
          {metrics.map((m) => (
            <div class="flex flex-col-reverse">
              <dt class="text-xs leading-snug text-muted">{m.label}</dt>
              <dd class="text-lg font-bold tabular-nums">{m.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      !compact && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t.stack}>
          {d.tags.map((tag) => (
            <li class="rounded border border-rule px-1.5 py-0.5 text-xs text-muted">{tag}</li>
          ))}
        </ul>
      )
    }

    <p class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-semibold text-accent-ink" aria-hidden="true">
      {t.readCase}
      <Icon name="arrowRight" class="size-4" />
    </p>
  </div>
</article>
