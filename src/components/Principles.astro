---
import { routes, ui } from '../lib/i18n.ts';
import type { CV, Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';
import Icon from './Icon.astro';

interface Props {
  principles: CV['principles'];
  title: string;
  lang: Lang;
  /** `compact` para la columna del CV; `wide` para la portada. */
  variant?: 'compact' | 'wide';
}

const { principles, title, lang, variant = 'compact' } = Astro.props;
const t = ui[lang];
---

{
  principles.length > 0 && (
    <section aria-labelledby="principles-title">
      <h2
        id="principles-title"
        class:list={[
          variant === 'wide'
            ? 'text-2xl font-bold tracking-tight sm:text-3xl'
            : 'mb-4 flex items-center gap-3 text-xs font-bold tracking-[0.12em] text-accent-ink uppercase after:h-px after:flex-1 after:bg-rule',
        ]}
      >
        {title}
      </h2>
      <ol class:list={['grid', variant === 'wide' ? 'mt-8 gap-8 md:grid-cols-3' : 'gap-5']}>
        {principles.map((p) => (
          <li class:list={[variant === 'wide' && 'border-t-2 border-accent pt-4']}>
            <h3 class="font-semibold">{p.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-pretty text-muted">{p.description}</p>
            {p.project && (
              <a
                href={withBase(routes.project(p.project)[lang])}
                class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-accent-ink hover:underline"
              >
                {t.principleCase}
                <Icon name="arrowRight" class="size-3.5" />
              </a>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
