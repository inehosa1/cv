---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { loadCV } from '../lib/cv.ts';
import { formatDate } from '../lib/format.ts';
import { routes, ui } from '../lib/i18n.ts';
import { projectSlug, sortProjects } from '../lib/projects.ts';
import type { Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';
import Icon from './Icon.astro';
import Principles from './Principles.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = loadCV(lang);
const t = ui[lang];
const L = cv.meta.labels;
const other: Lang = lang === 'es' ? 'en' : 'es';
const projects = sortProjects(await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)));

const allTags = new Set(projects.flatMap((p) => p.data.tags));
const clients = new Set(projects.map((p) => p.data.client));
const title = `${t.projectsTitle} — ${cv.basics.name}`;
const description = t.projectsIntro;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  author: { '@type': 'Person', name: cv.basics.name },
  hasPart: projects.map((p) => ({
    '@type': 'CreativeWork',
    name: p.data.title,
    description: p.data.tagline,
    url: withBase(routes.project(projectSlug(p))[lang]),
  })),
};
---

<Base cv={cv} title={title} description={description} paths={routes.projects} jsonLd={jsonLd}>
  <SiteNav lang={lang} current="projects" altPath={routes.projects[other]} name={cv.basics.name} />

  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-16">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.12em] text-accent-ink uppercase">{t.projectsKicker}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">{t.projectsTitle}</h1>
      <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{t.projectsIntro}</p>
    </header>

    <dl class="mt-10 grid max-w-2xl grid-cols-3 gap-4">
      {
        [
          { value: projects.length, label: lang === 'es' ? 'casos de estudio' : 'case studies' },
          { value: clients.size, label: lang === 'es' ? 'clientes' : 'clients' },
          { value: allTags.size, label: lang === 'es' ? 'áreas técnicas' : 'technical areas' },
        ].map((s) => (
          <div class="rounded-xl border border-rule bg-surface p-4">
            <dt class="text-xs text-muted">{s.label}</dt>
            <dd class="mt-1 text-3xl font-bold tabular-nums">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <ol class="mt-12 grid gap-6 md:grid-cols-2">
      {
        projects.map((p) => {
          const d = p.data;
          return (
            <li>
              <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-rule bg-surface p-6 shadow-sm transition hover:border-accent/60 hover:shadow-md sm:p-8 dark:shadow-none">
                <div class="absolute inset-x-0 top-0 h-1 bg-accent opacity-0 transition group-hover:opacity-100" aria-hidden="true" />
                <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-muted">
                  {d.status === 'development' && (
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/40 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-800 dark:text-amber-300">
                      <span class="size-1.5 animate-pulse rounded-full bg-amber-500" aria-hidden="true" />
                      {t.inDevelopment}
                    </span>
                  )}
                  <p>
                  {d.client} · {d.company} ·{' '}
                  <time datetime={d.start}>{formatDate(d.start, L)}</time> –{' '}
                  {d.end ? <time datetime={d.end}>{formatDate(d.end, L)}</time> : L.present}
                  </p>
                </div>
                <h2 class="mt-2 text-xl font-semibold tracking-tight">
                  <a href={withBase(routes.project(projectSlug(p))[lang])} class="after:absolute after:inset-0">
                    {d.title}
                  </a>
                </h2>
                <p class="mt-2 leading-relaxed text-pretty text-muted">{d.tagline}</p>

                {d.metrics.length > 0 && (
                  <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
                    {d.metrics.slice(0, 3).map((m) => (
                      <div>
                        <dt class="sr-only">{m.label}</dt>
                        <dd class="text-lg font-bold text-accent-ink tabular-nums">{m.value}</dd>
                        <dd class="text-xs leading-snug text-muted">{m.label}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                <ul class="mt-6 flex flex-wrap gap-1.5" aria-label={t.stack}>
                  {d.tags.map((tag) => (
                    <li class="rounded-md border border-chip-border bg-chip px-2 py-0.5 text-xs font-medium text-accent-ink">
                      {tag}
                    </li>
                  ))}
                </ul>

                <p class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-semibold text-accent-ink" aria-hidden="true">
                  {t.readCase}
                  <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
                </p>
              </article>
            </li>
          );
        })
      }
    </ol>

    <div class="mt-20">
      <Principles principles={cv.principles} title={t.principlesTitle} variant="wide" />
    </div>
  </main>
</Base>
