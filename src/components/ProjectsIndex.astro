---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { loadCV } from '../lib/cv.ts';
import { filtersFor, techFilters } from '../lib/filters.ts';
import { formatDate } from '../lib/format.ts';
import { routes, ui } from '../lib/i18n.ts';
import { type Project, projectSlug, splitByTier } from '../lib/projects.ts';
import type { Lang } from '../lib/schema.ts';
import { absoluteUrl, withBase } from '../lib/url.ts';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = loadCV(lang);
const t = ui[lang];
const L = cv.meta.labels;
const other: Lang = lang === 'es' ? 'en' : 'es';
const all = await getCollection('projects', (e) => e.id.startsWith(`${lang}/`));
const { main, other: rest } = splitByTier(all);
const site = Astro.site ?? 'http://localhost:4321';
const href = (p: Project) => withBase(routes.project(projectSlug(p))[lang]);

// Filtros que aplican a cada proyecto; solo se muestran los que agrupan 2 o más.
const projectFilters = new Map(
  all.map((p) => [
    p.id,
    filtersFor([p.data.title, ...p.data.tags, ...p.data.stack.flatMap((s) => s.items)]),
  ]),
);
const filters = techFilters
  .map((f) => ({
    ...f,
    count: all.filter((p) => projectFilters.get(p.id)?.includes(f.id)).length,
  }))
  .filter((f) => f.count >= 2);

const title = `${t.projectsTitle} — ${cv.basics.name}`;
const description = t.projectsIntro;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: absoluteUrl(routes.projects[lang], site),
  author: { '@type': 'Person', name: cv.basics.name },
  hasPart: [...main, ...rest].map((p) => ({
    '@type': 'CreativeWork',
    name: p.data.title,
    description: p.data.tagline,
    url: absoluteUrl(routes.project(projectSlug(p))[lang], site),
  })),
};
---

<Base cv={cv} title={title} description={description} paths={routes.projects} jsonLd={jsonLd}>
  <SiteNav lang={lang} current="projects" altPath={routes.projects[other]} name={cv.basics.name} />

  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-16">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold text-accent-ink">{t.projectsKicker}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-balance sm:text-5xl">{t.projectsTitle}</h1>
      <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{t.projectsIntro}</p>
    </header>

    <!-- Filtro por tecnología: oculto hasta que el script lo activa (sin JS se ven todos los proyectos). -->
    <div data-filters hidden class="mt-10">
      <p id="filter-label" class="text-sm font-semibold">{t.filterLabel}</p>
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-labelledby="filter-label">
        <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">
          {t.filterAll} <span class="font-normal tabular-nums">{all.length}</span>
        </button>
        {
          filters.map((f) => (
            <button type="button" data-filter={f.id} aria-pressed="false" class="filter-chip">
              {f.label[lang]} <span class="font-normal tabular-nums">{f.count}</span>
            </button>
          ))
        }
      </div>
      <p data-filter-status class="sr-only" aria-live="polite"></p>
    </div>

    <!-- Destacados a todo el ancho; el resto de casos principales en 3 columnas (sin huecos con 3). -->
    <ol class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        main.map((p) => (
          <li data-project data-filters-list={projectFilters.get(p.id)?.join(' ')} class:list={[p.data.featured && 'md:col-span-2 lg:col-span-3']}>
            <ProjectCard entry={p} lang={lang} labels={L} featured={p.data.featured} />
          </li>
        ))
      }
    </ol>

    {
      rest.length > 0 && (
        <section aria-labelledby="other-title" data-section class="mt-20">
          <h2 id="other-title" class="text-2xl font-bold tracking-tight">{t.otherProjects}</h2>
          <p class="mt-2 text-muted">{t.otherProjectsIntro}</p>
          <ul class="mt-6 divide-y divide-rule border-y border-rule">
            {rest.map((p) => (
              <li data-project data-filters-list={projectFilters.get(p.id)?.join(' ')} class="group relative py-5">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <h3 class="font-semibold">
                    <a href={href(p)} class="after:absolute after:inset-0 group-hover:text-accent-ink">
                      {p.data.title}
                    </a>
                  </h3>
                  <p class="shrink-0 text-xs text-muted tabular-nums">
                    {p.data.status === 'development' && <span class="status-badge mr-2">{t.inDevelopment}</span>}
                    {formatDate(p.data.start, L)} – {p.data.end ? formatDate(p.data.end, L) : L.present}
                  </p>
                </div>
                <p class="mt-1 max-w-3xl text-sm leading-relaxed text-pretty text-muted">{p.data.tagline}</p>
                <p class="mt-2 flex items-center gap-1 text-xs text-muted">
                  {p.data.client}
                  <Icon name="arrowRight" class="ml-auto size-4 text-accent-ink" />
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-24">
      <Contact cv={cv} lang={lang} />
    </div>
  </main>
</Base>

<script is:inline data-count-label={t.filterCount}>
  (() => {
    const root = document.querySelector('[data-filters]');
    if (!root) return;
    const items = [...document.querySelectorAll('[data-project]')];
    const sections = [...document.querySelectorAll('[data-section]')];
    const buttons = [...root.querySelectorAll('[data-filter]')];
    const status = root.querySelector('[data-filter-status]');
    const label = document.currentScript?.dataset.countLabel ?? '';
    root.hidden = false;
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const id = button.dataset.filter;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        let shown = 0;
        for (const item of items) {
          const match = id === 'all' || (item.dataset.filtersList ?? '').split(' ').includes(id);
          item.hidden = !match;
          if (match) shown++;
        }
        // Una sección sin proyectos visibles se oculta entera (también su título).
        for (const s of sections) s.hidden = !s.querySelector('[data-project]:not([hidden])');
        if (status) status.textContent = `${shown} ${label}`;
      });
    }
  })();
</script>
