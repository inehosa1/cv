---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { loadCV } from '../lib/cv.ts';
import { yearRange } from '../lib/format.ts';
import { routes, ui } from '../lib/i18n.ts';
import { sortProjects } from '../lib/projects.ts';
import type { Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';
import Button from './Button.astro';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
import Principles from './Principles.astro';
import ProjectCard from './ProjectCard.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = loadCV(lang);
const t = ui[lang];
const L = cv.meta.labels;
const b = cv.basics;
const other: Lang = lang === 'es' ? 'en' : 'es';

const projects = sortProjects(await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)));
const featured = projects.filter((p) => p.data.featured).slice(0, 3);

const career = cv.work.map((w) => ({
  name: w.name,
  position: w.position,
  years: yearRange(w.startDate, w.endDate, L.present),
  current: !w.endDate,
}));
---

<Base cv={cv} paths={routes.home}>
  <SiteNav lang={lang} current="home" altPath={routes.home[other]} name={b.name} />

  <main id="main">
    <section class="border-b border-rule">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:py-24">
        <p class="text-sm text-muted">
          {b.location.city}, {b.location.country} · {b.availability ?? b.location.remote}
        </p>
        <h1 class="mt-4 max-w-4xl text-3xl leading-tight font-bold tracking-tight text-balance sm:text-5xl">
          {cv.home.headline}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-muted">{cv.home.intro}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={withBase(routes.projects[lang])} variant="primary" icon="layers">
            {t.ctaProjects}
          </Button>
          <Button href={withBase(routes.cv[lang])} iconAfter="arrowRight">{t.ctaCv}</Button>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl space-y-24 px-4 py-20 sm:px-6">
      <section aria-labelledby="featured-title">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="featured-title" class="text-2xl font-bold tracking-tight sm:text-3xl">{t.featuredTitle}</h2>
          <a
            href={withBase(routes.projects[lang])}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-ink hover:underline"
          >
            {t.allCases} ({projects.length})
            <Icon name="arrowRight" class="size-4" />
          </a>
        </div>
        <ul class="mt-8 space-y-6">
          {
            featured.map((p) => (
              <li>
                <ProjectCard entry={p} lang={lang} labels={L} featured compact />
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="career-title" class="reveal">
        <h2 id="career-title" class="text-2xl font-bold tracking-tight sm:text-3xl">{t.careerTitle}</h2>
        <ol class="mt-8 max-w-3xl divide-y divide-rule border-y border-rule">
          {
            career.map((c) => (
              <li class="flex flex-col gap-0.5 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <p>
                  <span class="font-semibold">{c.name}</span>
                  <span class="text-muted"> · {c.position}</span>
                </p>
                <p class:list={['shrink-0 text-sm tabular-nums', c.current ? 'font-medium' : 'text-muted']}>
                  {c.years}
                </p>
              </li>
            ))
          }
        </ol>
        <a
          href={withBase(routes.cv[lang])}
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-ink hover:underline"
        >
          {t.ctaCv}
          <Icon name="arrowRight" class="size-4" />
        </a>
      </section>

      <div class="reveal">
        <Principles principles={cv.principles} title={t.principlesTitle} lang={lang} variant="wide" />
      </div>

      <Contact cv={cv} lang={lang} />
    </div>
  </main>
</Base>
