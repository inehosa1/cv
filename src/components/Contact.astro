---
import { ui } from '../lib/i18n.ts';
import type { CV, Lang } from '../lib/schema.ts';
import { prettyUrl, withBase } from '../lib/url.ts';
import Button from './Button.astro';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  cv: CV;
  lang: Lang;
}

const { cv, lang } = Astro.props;
const t = ui[lang];
const b = cv.basics;
const pdfName = `${b.name.replaceAll(' ', '_')}_CV_${lang.toUpperCase()}.pdf`;
/** Perfiles públicos. El teléfono solo va en el PDF (evita scraping y spam). */
const profiles = b.profiles.map((p) => ({
  icon: (['linkedin', 'github'].includes(p.network.toLowerCase())
    ? p.network.toLowerCase()
    : 'link') as IconName,
  label: prettyUrl(p.url),
  href: p.url,
}));
---

<section id="contacto" aria-labelledby="contact-title" class="no-print reveal scroll-mt-20 border-t border-rule pt-12">
  <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
    <div class="max-w-xl">
      <h2 id="contact-title" class="text-2xl font-bold tracking-tight sm:text-3xl">{t.contactTitle}</h2>
      <p class="mt-3 text-pretty text-muted">{t.contactText}</p>
      <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          profiles.map((l) => (
            <li>
              <a href={l.href} rel="me noopener" target="_blank" class="inline-flex items-center gap-1.5 text-muted underline-offset-4 hover:text-accent-ink hover:underline">
                <Icon name={l.icon} class="size-4" />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="flex flex-wrap gap-3">
      <Button href={`mailto:${b.email}`} variant="primary" icon="mail">{b.email}</Button>
      <Button href={withBase(`/cv-${lang}.pdf`)} icon="download" download={pdfName}>
        {cv.meta.labels.downloadPdf}
      </Button>
    </div>
  </div>
</section>
