---
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className } = Astro.props;
---

<section aria-labelledby={`${id}-title`} class:list={['scroll-mt-6', className]}>
  <h2
    id={`${id}-title`}
    class="mb-4 flex items-center gap-3 text-xs font-bold tracking-[0.12em] text-accent-ink uppercase after:h-px after:flex-1 after:bg-rule"
  >
    {title}
  </h2>
  <slot />
</section>
