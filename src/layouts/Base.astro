---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { plain } from '../lib/format.ts';
import type { CV, Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';

interface Props {
  cv: CV;
  /** Por defecto, los del CV. */
  title?: string;
  description?: string;
  /** Ruta de esta página en cada idioma (para canonical y hreflang). */
  paths?: Record<Lang, string>;
  /** JSON-LD propio; si se omite, se usa el ProfilePage/Person del CV. */
  jsonLd?: Record<string, unknown>;
}

const { cv, paths = { es: '/', en: '/en/' } } = Astro.props;
const { meta, basics } = cv;
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;
const site = Astro.site ?? new URL('http://localhost:4321');
const abs = (path: string) => new URL(withBase(path), site).href;

const canonical = abs(paths[meta.lang]);
const alternates = [
  { hreflang: 'es', href: abs(paths.es) },
  { hreflang: 'en', href: abs(paths.en) },
  { hreflang: 'x-default', href: abs(paths.es) },
];
const ogImage = abs(`/og-${meta.lang}.png`);
const current = cv.work.find((w) => !w.endDate);

// schema.org/Person para buscadores (sin teléfono: evita scraping).
const profileLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: meta.lastModified,
  mainEntity: {
    '@type': 'Person',
    name: basics.name,
    jobTitle: basics.label,
    description: plain(basics.summary),
    email: `mailto:${basics.email}`,
    url: canonical,
    image: ogImage,
    address: {
      '@type': 'PostalAddress',
      addressLocality: basics.location.city,
      addressCountry: basics.location.countryCode,
    },
    sameAs: basics.profiles.map((p) => p.url),
    knowsAbout: cv.skills.flatMap((s) => s.featured),
    knowsLanguage: cv.languages.map((l) => l.language),
    alumniOf: cv.education.map((e) => ({
      '@type': 'EducationalOrganization',
      name: e.institution,
    })),
    ...(current && { worksFor: { '@type': 'Organization', name: current.name } }),
  },
};
const jsonLd = Astro.props.jsonLd ?? profileLd;
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={basics.name} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={meta.lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
