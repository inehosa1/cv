{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 80,
          "maxLength": 170
        },
        "lastModified": {
          "type": "string",
          "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
        },
        "labels": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "competencies": {
              "type": "string"
            },
            "work": {
              "type": "string"
            },
            "projects": {
              "type": "string"
            },
            "skills": {
              "type": "string"
            },
            "education": {
              "type": "string"
            },
            "certificates": {
              "type": "string"
            },
            "languages": {
              "type": "string"
            },
            "technologies": {
              "type": "string"
            },
            "present": {
              "type": "string"
            },
            "downloadPdf": {
              "type": "string"
            },
            "switchLang": {
              "type": "string"
            },
            "contact": {
              "type": "string"
            },
            "degreeIn": {
              "type": "string"
            },
            "months": {
              "minItems": 12,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "summary",
            "competencies",
            "work",
            "projects",
            "skills",
            "education",
            "certificates",
            "languages",
            "technologies",
            "present",
            "downloadPdf",
            "switchLang",
            "contact",
            "degreeIn",
            "months"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "lang",
        "title",
        "description",
        "lastModified",
        "labels"
      ],
      "additionalProperties": false
    },
    "basics": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "countryCode": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "country": {
              "type": "string"
            },
            "remote": {
              "type": "string"
            }
          },
          "required": [
            "city",
            "countryCode",
            "country"
          ],
          "additionalProperties": false
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "network": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "network",
              "username",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "label",
        "email",
        "summary",
        "location",
        "profiles"
      ],
      "additionalProperties": false
    },
    "principles": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "competencies": {
      "minItems": 3,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "technologies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "position",
          "location",
          "startDate",
          "highlights"
        ],
        "additionalProperties": false
      }
    },
    "projects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "highlights": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "technologies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "featured": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "keywords"
        ],
        "additionalProperties": false
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "studyType": {
            "type": "string"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "institution",
          "area",
          "studyType",
          "endDate"
        ],
        "additionalProperties": false
      }
    },
    "certificates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "fluency": {
            "type": "string"
          }
        },
        "required": [
          "language",
          "fluency"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "basics",
    "competencies",
    "work",
    "skills",
    "education",
    "languages"
  ],
  "additionalProperties": false
}
